# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://inglish:inglish@localhost:5432/inglish?schema=public

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# CORS: comma-separated origins, or * for development
CORS_ORIGIN=*

# Set to true only when the API runs behind a trusted reverse proxy
TRUST_PROXY=false

# Access token TTL
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# AI scoring: auto | mock | gemini
# auto uses Gemini when GEMINI_API_KEY is set, otherwise mock.
AI_SCORING_MODE=mock

# Server-side only. Never expose this key in the Android app.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash

# Transactional email: auto | log | smtp
# auto uses SMTP when SMTP_HOST is set, otherwise logs to the server console.
EMAIL_MODE=auto
EMAIL_FROM=Inglish <no-reply@inglish.uz>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=no-reply@example.com
# SMTP_PASS=your-smtp-password

# Email verification / password reset codes
AUTH_CODE_TTL_MINUTES=15
AUTH_CODE_MAX_ATTEMPTS=5
