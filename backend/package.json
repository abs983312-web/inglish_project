{
  "name": "@inglish/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:auth": "node scripts/smoke-auth.mjs",
    "smoke:auth:hardening": "node scripts/smoke-auth-hardening.mjs",
    "smoke:content": "node scripts/smoke-content.mjs",
    "smoke:content:inprocess": "tsx scripts/smoke-content-inprocess.ts",
    "smoke:features": "node scripts/smoke-features.mjs",
    "smoke:battle": "node scripts/smoke-battle.mjs",
    "smoke:battle:multiplayer": "node scripts/smoke-battle-multiplayer.mjs",
    "smoke:placement": "node scripts/smoke-placement.mjs",
    "smoke:billing": "node scripts/smoke-billing.mjs",
    "smoke:idempotency": "node scripts/smoke-idempotency.mjs",
    "db:dev": "node scripts/dev-db.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.0.3",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/websocket": "^11.3.7",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "google-auth-library": "^9.15.1",
    "googleapis": "^189.0.0",
    "nodemailer": "^7.0.13",
    "ws": "^8.22.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "embedded-postgres": "^18.6.0-beta.19",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
